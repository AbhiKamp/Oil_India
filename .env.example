# ==============================================================================
# STRATASENTRY-NWIS: SYSTEM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
SECRET_KEY=stratasentry-nwis-super-secret-key-change-in-prod-2026

# FastAPI Gateway Settings
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# TimescaleDB / PostGIS Database Configuration
DATABASE_URL=postgresql://stratasentry:nwis_secure_password_2026@localhost:5432/stratasentry_db
DB_POOL_MIN=5
DB_POOL_MAX=20

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=drilling_knowledge_chunks
QDRANT_API_KEY=

# Apache Kafka Telemetry Message Bus
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TELEMETRY_TOPIC=rig.telemetry.raw
KAFKA_STANDARDIZED_TOPIC=rig.telemetry.standardized
KAFKA_ALERTS_TOPIC=rig.alerts.immediate

# Machine Learning & Inference
MODEL_DEVICE=cpu
XGBOOST_MODEL_PATH=models/xgboost/stuck_pipe_xgb.json
LSTM_MODEL_PATH=models/lstm/lstm_anomaly_ae.pt
ENABLE_PHYSICS_VALIDATION=true

# Large Language Model / RAG Copilot
LLM_PROVIDER=offline_mock  # Options: offline_mock, mistral_local, ollama, openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=mistral:7b-instruct
MISTRAL_API_KEY=

# Air-Gapped Rig-Site Configuration
AIR_GAPPED_MODE=false
RIG_ID=OIL-INDIA-RIG-04
WELL_ID=NHK-421
SYNC_ENCRYPTION_KEY=32_byte_hex_encoded_key_for_chacha20_poly1305_sync
