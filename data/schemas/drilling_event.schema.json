{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DrillingEvent",
  "description": "Schema for structured historical and real-time drilling hazard events",
  "type": "object",
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "well_id": { "type": "string" },
    "well_name": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": [
        "STUCK_PIPE_PACKOFF",
        "STUCK_PIPE_DIFFERENTIAL",
        "STUCK_PIPE_KEYSEAT",
        "GAS_KICK",
        "LOST_CIRCULATION_PARTIAL",
        "LOST_CIRCULATION_TOTAL",
        "WELLBORE_COLLAPSE",
        "BIT_BALLING"
      ]
    },
    "measured_depth_m": { "type": "number", "minimum": 0 },
    "true_vertical_depth_m": { "type": "number", "minimum": 0 },
    "formation": { "type": "string" },
    "lithology": { "type": "string" },
    "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "description": { "type": "string" },
    "root_cause": { "type": "string" },
    "npt_hours": { "type": "number", "minimum": 0 },
    "mitigation_procedure": { "type": "string" },
    "source_report": { "type": "string" },
    "page_reference": { "type": "integer", "minimum": 1 }
  },
  "required": ["well_name", "event_type", "measured_depth_m", "severity", "description"]
}
